  "fileGroups": {
    "group-pi": [
      {
        "name": "script.py",
        "content": "\"\"\"Bench communication check. Sends STATUS only; no autonomous motion.\"\"\"\nimport time\nimport serial\n\nport = serial.Serial(\"/dev/serial0\", baudrate=9600, timeout=0.2)\nprint(\"Pi running: STATUS-only bench test\")\ntry:\n    while True:\n        port.write(b\"STATUS\\n\")\n        reply = port.readline().decode(errors=\"replace\").strip()\n        if reply:\n            print(reply)\n        time.sleep(1)\nfinally:\n    port.close()\n"
      }
    ],
    "group-esp": [
      {
        "name": "sketch.ino",
        "content": "// WIRING / BENCH TEST ONLY. Motor enables remain OFF.\n#include <Arduino.h>\n#include <Wire.h>\n\nconst int FRONT_TRIG=4, FRONT_ECHO=34, DOWN_TRIG=13, DOWN_ECHO=35;\nconst int REPAIR_REQUEST=23, REPAIR_ACK=33, ESTOP=32, BATTERY_POT=36;\nconst int ENA=25, IN1=26, IN2=27, ENB=14, IN3=18, IN4=19;\nHardwareSerial PiLink(2);\nString line;\nbool requested=false;\nunsigned long repairStarted=0, sampled=0;\nfloat front=-1, down=-1;\n\nfloat cm(int trig,int echo) {\n  digitalWrite(trig,LOW); delayMicroseconds(3);\n  digitalWrite(trig,HIGH); delayMicroseconds(10); digitalWrite(trig,LOW);\n  unsigned long us=pulseIn(echo,HIGH,25000);\n  return us ? us/58.0f : -1;\n}\nvoid stopOutputs() {\n  digitalWrite(ENA,LOW); digitalWrite(ENB,LOW);\n  digitalWrite(IN1,LOW); digitalWrite(IN2,LOW);\n  digitalWrite(IN3,LOW); digitalWrite(IN4,LOW);\n}\nvoid setup() {\n  Serial.begin(115200);\n  PiLink.begin(9600,SERIAL_8N1,16,17);\n  const int outputs[]={ENA,IN1,IN2,ENB,IN3,IN4,FRONT_TRIG,DOWN_TRIG,REPAIR_REQUEST};\n  for(int p: outputs) {\n    pinMode(p,OUTPUT); digitalWrite(p,LOW);\n  }\n  pinMode(FRONT_ECHO,INPUT); pinMode(DOWN_ECHO,INPUT); pinMode(REPAIR_ACK,INPUT);\n  pinMode(ESTOP,INPUT_PULLUP); pinMode(BATTERY_POT,INPUT);\n  stopOutputs(); Wire.begin(21,22);\n  Serial.println(\"ESP32 bench test ready; motor outputs disabled.\");\n  Wire.beginTransmission(0x3c);\n  Serial.println(Wire.endTransmission()==0 ? \"OLED detected at 0x3c\" : \"OLED not detected\");\n}\nvoid loop() {\n  stopOutputs(); // this starter never drives the virtual winding loads\n  if(millis()-sampled>=500) {\n    sampled=millis();\n    front=cm(FRONT_TRIG,FRONT_ECHO);\n    delay(35); // separate the two ultrasound pings\n    down=cm(DOWN_TRIG,DOWN_ECHO);\n  }\n  if(digitalRead(ESTOP)==LOW) { digitalWrite(REPAIR_REQUEST,LOW); requested=false; }\n  if(requested && (digitalRead(REPAIR_ACK)==HIGH || millis()-repairStarted>5000)) {\n    PiLink.println(digitalRead(REPAIR_ACK)==HIGH ? \"REPAIR_DONE\" : \"REPAIR_TIMEOUT\");\n    digitalWrite(REPAIR_REQUEST,LOW); requested=false;\n  }\n  while(PiLink.available()) {\n    char c=PiLink.read();\n    if(c=='\\r') continue;\n    if(c!='\\n') { if(line.length()<60) line+=c; else line=\"\"; continue; }\n    line.trim();\n    if(line==\"STATUS\") {\n      PiLink.printf(\"STATUS front=%.1f down=%.1f battery_adc=%d estop=%d ack=%d\\n\",\n        front,down,analogRead(BATTERY_POT),digitalRead(ESTOP)==LOW,digitalRead(REPAIR_ACK));\n    } else if(line==\"STOP\") {\n      digitalWrite(REPAIR_REQUEST,LOW); requested=false; PiLink.println(\"STOPPED\");\n    } else if(line==\"REPAIR\" && !requested && digitalRead(ESTOP)==HIGH) {\n      digitalWrite(REPAIR_REQUEST,HIGH); requested=true; repairStarted=millis();\n    }\n    line=\"\";\n  }\n  delay(5);\n}\n"
      }
    ],
    "group-uno": [
      {
        "name": "sketch.ino",
        "content": "// Servo-gate bench controller. This is not a granular repair-material simulation.\n#include <Servo.h>\nconst int REQUEST=2, ACK=3, SERVO_PIN=9;\nServo gate;\nbool dispensing=false, served=false;\nunsigned long opened=0;\nvoid setup() {\n  pinMode(REQUEST,INPUT); pinMode(ACK,OUTPUT); digitalWrite(ACK,LOW);\n  gate.attach(SERVO_PIN); gate.write(0);\n}\nvoid loop() {\n  bool request=digitalRead(REQUEST)==HIGH;\n  if(!request) {\n    gate.write(0); dispensing=false; served=false; digitalWrite(ACK,LOW);\n  } else if(!dispensing && !served) {\n    gate.write(80); dispensing=true; opened=millis();\n  } else if(dispensing && millis()-opened>=2000) {\n    gate.write(0); dispensing=false; served=true; digitalWrite(ACK,HIGH);\n  }\n  delay(5);\n}\n"
      },
      {
        "name": "libraries.txt",
        "content": "Servo\n"
      }
    ]
  },
