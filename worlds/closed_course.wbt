Transform { translation 0 -.22 .12 children [ Shape { appearance PBRAppearance { baseColor .8 .6 .4 roughness 1 } geometry Box { size .10 .09 .55 } } ] }
Transform { translation 0 .22 .12 children [ Shape { appearance PBRAppearance { baseColor .8 .6 .4 roughness 1 } geometry Box { size .10 .09 .55 } } ] }
] boundingObject Box { size .24 .52 1.6 } }
